# ==============================================================================
# Environment Configuration — copy to .env and edit before deploying
# ==============================================================================

# --- Model Configuration ---
# Smaller models run comfortably on CPU-only VMs matching the sizing in README.md
MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# --- Vector DB ---
COLLECTION_NAME=rag_documents

# --- Application ---
LOG_LEVEL=INFO

# --- Grafana ---
# CHANGE THESE BEFORE ANY NON-LOCALHOST DEPLOYMENT — see docs/SECURITY.md
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# --- Networking (used by provisioning scripts) ---
# Set to the VM's actual reachable IP or hostname if deploying beyond localhost
VM_HOST=localhost
