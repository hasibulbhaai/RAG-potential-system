{
  "title": "RAG Platform Overview",
  "uid": "rag-platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(rag_api_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} - {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Chat Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_api_request_latency_seconds_bucket{endpoint=\"/chat\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_api_request_latency_seconds_bucket{endpoint=\"/chat\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_api_request_latency_seconds_bucket{endpoint=\"/chat\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Documents Ingested (cumulative)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rag_api_documents_ingested_total" }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(rag_api_requests_total{status=\"error\"}[5m])) / sum(rate(rag_api_requests_total[5m]))"
        }
      ]
    }
  ]
}
